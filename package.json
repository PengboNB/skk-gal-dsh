{
  "name": "skk-gal",
  "version": "1.5.9",
  "description": "Portable Skirk-themed GAL conversation view for DeepSeek Harness Web",
  "type": "module",
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    ".dsh-plugin",
    "assets",
    "cordis.patch.yml",
    "CONFIGURATION.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "pack:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "connection"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT"
}
